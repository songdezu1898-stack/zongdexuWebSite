{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "宋德旭网站直播问答数据",
  "type": "object",
  "required": ["version", "updatedAt", "items"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "updatedAt": { "type": "string", "format": "date" },
    "sourceLabel": { "type": "string" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "slug",
          "date",
          "category",
          "question",
          "answer",
          "takeaway",
          "reviewStatus",
          "published"
        ],
        "properties": {
          "id": { "type": "string" },
          "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "date": { "type": "string", "format": "date" },
          "sourceDate": { "type": "string", "format": "date" },
          "datePublished": { "type": "string", "format": "date" },
          "dateModified": { "type": "string", "format": "date" },
          "category": { "enum": ["买房", "卖房", "置换", "产品"] },
          "region": { "type": "string" },
          "question": { "type": "string", "minLength": 6 },
          "answer": { "type": "string", "minLength": 20 },
          "takeaway": { "type": "string", "minLength": 6 },
          "keywords": {
            "type": "array",
            "items": { "type": "string", "minLength": 2 },
            "uniqueItems": true
          },
          "decisionPoints": {
            "type": "array",
            "minItems": 2,
            "maxItems": 6,
            "items": { "type": "string", "minLength": 6 },
            "uniqueItems": true
          },
          "reviewStatus": { "enum": ["candidate", "approved", "rejected"] },
          "published": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
